DRAGON_ENV=development
DRAGON_SECRET_KEY=
DRAGON_DATABASE_URL=
DRAGON_AUTH_REQUIRED=true
# Google-owned personal workspaces. Keep personal-vault login false until the
# workspace data migration is deployed. User-specific integrations are stored
# in that user's Drive vault, not in this shared deployment configuration.
DRAGON_GOOGLE_OAUTH_ENABLED=false
DRAGON_GOOGLE_PERSONAL_VAULT_LOGIN_ENABLED=false
DRAGON_GOOGLE_OAUTH_CLIENT_ID=
DRAGON_GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact callback URL in Google Cloud Console, for example:
# DRAGON_GOOGLE_OAUTH_REDIRECT_URI=https://your-account.pythonanywhere.com/auth/google/callback
DRAGON_GOOGLE_OAUTH_REDIRECT_URI=
# Enable only on the PythonAnywhere deployment: eager-load movie relations and
# cap the /movies recommendation payload at 24 items. Keep false locally.
DRAGON_PYTHONANYWHERE_LITE=false
DRAGON_AI_ENABLED=false
DRAGON_PLAYBACK_ENABLED=false
DRAGON_VIDSRC_ENABLED=false
DRAGON_VIDSRC_EMBED_URL=https://v2.vidsrc.me/embed
# VidLove uses TMDb identity endpoints and keeps its server picker inside the
# provider player. Enable only for content you are authorized to access.
DRAGON_VIDLOVE_ENABLED=false
DRAGON_VIDEOTUBE_ENABLED=false
# Set only for an authorized VideoTube embed endpoint.
# DRAGON_VIDEOTUBE_EMBED_URL=https://down.vidtube.one/embed-{asset_id}.html
# Or store it in instance/secrets/videotube_embed_url.
DRAGON_UPDOWN_ENABLED=false
# Set only for an authorized UpDown embed endpoint.
# DRAGON_UPDOWN_EMBED_URL=https://updown.icu/embed-{asset_id}-1280x640.html
DRAGON_STREAMWISH_ENABLED=false
# Enables CineSrc's direct TMDb movie/TV identity embed. No source mapping is
# needed; leave it off until you have independently approved the provider.
DRAGON_CINESRC_ENABLED=false
# Direct TMDb identity providers. They require no per-title mappings.
DRAGON_VIDCORE_ENABLED=false
DRAGON_VIDZEE_ENABLED=false
# Enables VIDEM's direct TMDb movie/TV identity embed.
DRAGON_VIDEM_ENABLED=false
# Set only for an authorized StreamWish embed endpoint.
# DRAGON_STREAMWISH_EMBED_URL=https://streamwish.com/e/{asset_id}
# Optional: enables the manual account-library sync button. Keep the API key in
# instance/secrets/streamwish_api_key (or set DRAGON_STREAMWISH_API_KEY outside git).
DRAGON_STREAMWISH_LIBRARY_SYNC_ENABLED=false
DRAGON_MIXDROP_ENABLED=false
# Set only for an authorized MixDrop embed endpoint.
# DRAGON_MIXDROP_EMBED_URL=https://mixdrop.ag/e/{asset_id}
# Optional: enables the manual account-library sync button. Keep credentials in
# instance/secrets/mixdrop_api_email and instance/secrets/mixdrop_api_key.
DRAGON_MIXDROP_LIBRARY_SYNC_ENABLED=false
DRAGON_STREAMTAPE_LIBRARY_SYNC_ENABLED=false
# Keep the API login/key in instance/secrets/streamtape_api_login and
# instance/secrets/streamtape_api_key (or inject them outside git).
DRAGON_DOODSTREAM_ENABLED=false
# Optional: enables DoodStream account-library sync. Keep the key in
# instance/secrets/doodstream_api_key (or inject it outside git).
DRAGON_DOODSTREAM_LIBRARY_SYNC_ENABLED=false
# Optional: enables LuluStream account-library sync. Keep the key in
# instance/secrets/lulustream_api_key (or inject it outside git).
DRAGON_LULUSTREAM_LIBRARY_SYNC_ENABLED=false
DRAGON_UQLOAD_ENABLED=false
# Set only for an authorized Uqload embed endpoint.
# DRAGON_UQLOAD_EMBED_URL=https://uqload.cx/embed-{asset_id}.html
# Optional: enables FileLions/EarnVids account-library sync. Keep the key in
# instance/secrets/filelions_api_key (or inject it outside git).
DRAGON_FILELIONS_LIBRARY_SYNC_ENABLED=false
# Set only for an authorized DoodStream embed endpoint.
# DRAGON_DOODSTREAM_EMBED_URL=https://dood.to/e/{asset_id}
DRAGON_FILELIONS_ENABLED=false
# Set only for an authorized FileLions embed endpoint.
# DRAGON_FILELIONS_EMBED_URL=https://filelions.to/v/{asset_id}
DRAGON_OK_ENABLED=false
# Set only for an authorized OK embed endpoint.
# DRAGON_OK_EMBED_URL=https://ok.ru/videoembed/{asset_id}
DRAGON_STREAMTAPE_ENABLED=false
# Set only for an authorized StreamTape embed endpoint.
# DRAGON_STREAMTAPE_EMBED_URL=https://streamtape.com/e/{asset_id}
DRAGON_LULUSTREAM_ENABLED=false
# Set only for an authorized LuluStream embed endpoint.
# DRAGON_LULUSTREAM_EMBED_URL=https://lulustream.com/e/{asset_id}
DRAGON_TMDB_API_KEY=
DRAGON_TMDB_READ_ACCESS_TOKEN=
DRAGON_JACKETT_ENABLED=false
DRAGON_JACKETT_URL=http://127.0.0.1:9117
DRAGON_JACKETT_API_KEY=
DRAGON_JACKETT_MIN_SEEDERS=5
DRAGON_MAGNETS_ENABLED=false
DRAGON_PLAYBACK_CACHE_GB=10
DRAGON_PLAYBACK_CACHE_TTL_HOURS=168
DRAGON_SUBTITLES_ENABLED=false
DRAGON_SUBTITLE_PROVIDER=auto
DRAGON_WYZIE_API_KEY=
DRAGON_WYZIE_BASE_URL=https://sub.wyzie.io
DRAGON_SUBDL_API_KEY=
DRAGON_SUBTITLE_LANGUAGES=ar,en
DRAGON_EXTERNAL_SYNC_ENABLED=false
DRAGON_TV_EPG_ENABLED=true
DRAGON_TV_EPG_REFRESH_MINUTES=360
# Optional comma-separated XMLTV/XMLTV.GZ URLs. Point this at the XMLTV output
# generated by your iptv-org/epg worker; Dragon validates each channel's
# current/future coverage before accepting it. Leave empty for public fallbacks.
DRAGON_TV_EPG_URLS=
# Send favorite channels directly to the viewer's device.  This avoids a
# server-side stream proxy, but direct browser playback still depends on the
# provider allowing it (including CORS for HLS on desktop browsers).
DRAGON_MYTV_DIRECT_FAVORITES=false
# Maximum seconds to establish an IPTV connection through Dragon's proxy.
DRAGON_MYTV_HTTP_TIMEOUT=15
DRAGON_NOTION_SYNC_ENABLED=false
DRAGON_NOTION_WRITEBACK_ENABLED=false
DRAGON_NOTION_TOKEN=
DRAGON_NOTION_DATABASE_ID=
DRAGON_NOTION_DATA_SOURCE_ID=
DRAGON_BOOK_NOTION_DATABASE_ID=
DRAGON_BOOK_NOTION_DATA_SOURCE_ID=
DRAGON_NOTION_TV_SHOW_DATABASE_ID=
DRAGON_NOTION_TV_SHOW_DATA_SOURCE_ID=
DRAGON_NOTION_TV_EPISODE_DATABASE_ID=
DRAGON_NOTION_TV_EPISODE_DATA_SOURCE_ID=
DRAGON_NOTION_SYNC_TTL_SECONDS=120
DRAGON_YOUTUBE_DELETE_ENABLED=false
DRAGON_YOUTUBE_SYNC_ENABLED=false
DRAGON_YOUTUBE_API_KEY=
DRAGON_YOUTUBE_WATCH_LATER_PLAYLIST_ID=
DRAGON_READING_TTS_ENABLED=false
